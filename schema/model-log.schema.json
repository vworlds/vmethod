{
  "$id": "model-log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "repo",
    "pr",
    "task",
    "kind",
    "segments",
    "points_open",
    "points_final",
    "rounds",
    "round_causes",
    "outcome",
    "prompt_defects",
    "stalls",
    "findings",
    "notes"
  ],
  "properties": {
    "metrics": { "$ref": "#/$defs/metrics" },
    "tokens": { "$ref": "#/properties/segments/items/properties/tokens" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "pr": { "type": "integer", "minimum": 1 },
    "task": { "type": "string" },
    "kind": { "type": "string" },
    "usd": { "type": ["number", "null"], "minimum": 0 },
    "costSource": { "enum": ["backfill", "backfill-partial"] },
    "costBasis": { "enum": ["api-list"] },
    "costCoverage": { "enum": ["complete", "partial"] },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "model", "rounds", "why"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "metrics": { "$ref": "#/$defs/metrics" },
          "switchReason": {
            "enum": [
              "quota",
              "stopped-twice",
              "red-tests-blocked",
              "amendment-ignored",
              "owner-hint",
              "conflict-only",
              "orchestrator-judgement"
            ]
          },
          "model": { "type": "string", "minLength": 1 },
          "points_open": { "anyOf": [{ "$ref": "#/properties/points_open" }, { "type": "null" }] },
          "points_final": {
            "anyOf": [{ "$ref": "#/properties/points_final" }, { "type": "null" }]
          },
          "outcome": { "enum": ["merged", "abandoned", "switched", "replaced"] },
          "tokens": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["input", "output", "cached"],
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "cached": { "type": "number", "minimum": 0 }
            }
          },
          "usd": { "type": ["number", "null"], "minimum": 0 },
          "reportedUsd": { "type": "number", "minimum": 0 },
          "rounds": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "points_open": { "enum": [0, 0.5, 1, 2, 3, 5, 8, 13, 20, 40, 100, 999] },
    "points_final": { "enum": [0, 0.5, 1, 2, 3, 5, 8, 13, 20, 40, 100, 999] },
    "rounds": { "type": "integer", "minimum": 1 },
    "round_causes": {
      "type": "array",
      "items": {
        "enum": [
          "worker-defect",
          "design-change",
          "playtest-design-change",
          "owner-question",
          "new-requirement",
          "integration",
          "prompt-defect"
        ]
      }
    },
    "outcome": { "enum": ["merged", "rejected-in-playtest", "reassigned", "abandoned"] },
    "prompt_defects": {
      "type": "array",
      "items": { "enum": ["under-specified", "scope-withdrawn", "wrong-premise"] }
    },
    "stalls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minutes", "cause", "detected_by"],
        "properties": {
          "minutes": { "type": "number", "minimum": 0 },
          "cause": { "type": "string" },
          "detected_by": { "enum": ["watcher", "orchestrator", "owner"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "caught_by"],
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "caught_by": {
            "enum": ["worker-tests", "ci", "orchestrator-verify", "owner-playtest", "post-merge"]
          },
          "root_cause_by": { "enum": ["worker", "orchestrator"] }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "measurement": { "type": ["number", "null"], "minimum": 0 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviews",
        "checkins",
        "stopsWithoutStatus",
        "blocked",
        "questions",
        "escalations",
        "workingMs",
        "ownerWaitMs",
        "peakContext",
        "compactions",
        "diff"
      ],
      "properties": {
        "reviews": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changes", "answer", "conflict", "ownerChange"],
          "properties": {
            "changes": { "$ref": "#/$defs/count" },
            "answer": { "$ref": "#/$defs/count" },
            "conflict": { "$ref": "#/$defs/measurement" },
            "ownerChange": { "$ref": "#/$defs/count" }
          }
        },
        "checkins": { "$ref": "#/$defs/measurement" },
        "stopsWithoutStatus": { "$ref": "#/$defs/measurement" },
        "blocked": { "$ref": "#/$defs/count" },
        "questions": { "$ref": "#/$defs/count" },
        "escalations": { "$ref": "#/$defs/count" },
        "workingMs": { "$ref": "#/$defs/measurement" },
        "ownerWaitMs": { "$ref": "#/$defs/measurement" },
        "peakContext": { "$ref": "#/$defs/measurement" },
        "compactions": { "$ref": "#/$defs/measurement" },
        "diff": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["files", "additions", "deletions"],
          "properties": {
            "files": { "$ref": "#/$defs/count" },
            "additions": { "$ref": "#/$defs/count" },
            "deletions": { "$ref": "#/$defs/count" }
          }
        }
      }
    }
  }
}
