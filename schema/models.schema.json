{
  "$id": "models",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["family", "model", "kind", "gate"],
    "properties": {
      "family": { "type": "string" },
      "model": { "type": "string", "pattern": "^[^/\\s]+/[^\\s]+$" },
      "kind": { "type": "string", "minLength": 1 },
      "gate": { "enum": ["none", "owner"] }
    }
  }
}
